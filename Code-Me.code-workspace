{
  "folders": [
    {
      "path": "cmp"
    }
  ],
  "settings": {
    // fwcd.kotlin desativado: conflita com o Kotlin LSP oficial da JetBrains
    "kotlin.languageServer.enabled": false,
    "kotlin.debugAdapter.enabled": false,

    // Kotlin by JetBrains (kotlin-lsp oficial, baseado no IntelliJ)
    "intellij.buildTool": "gradle",

    // Navegação direta sem painel "peek"
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleReferences": "goto",

    "files.exclude": {
      "**/build": true,
      "**/.gradle": true,
      "**/.idea": true,
      "**/.kotlin": true
    },
    "files.watcherExclude": {
      "**/build/**": true,
      "**/.gradle/**": true,
      "**/.kotlin/**": true
    },
    "search.exclude": {
      "**/build": true,
      "**/.gradle": true,
      "**/.kotlin": true
    }
  },
  "extensions": {
    "recommendations": [
      "JetBrains.kotlin-server",
      "vscjava.vscode-gradle"
    ],
    "unwantedRecommendations": [
      "fwcd.kotlin",
      "mathiasfrohlich.Kotlin"
    ]
  }
}
